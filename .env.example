# Copy to .env and fill in as needed.

# Prefect API location (set automatically by docker-compose for containers)
PREFECT_API_URL=http://localhost:4200/api

# --- Proxy (only if your network requires one) ---
# These get picked up by docker-compose (see build.args in docker-compose.yml)
# and passed into the Dockerfile's ARG http_proxy/https_proxy/no_proxy.
# Just setting these here is enough — no Dockerfile edits needed per change.
http_proxy=
https_proxy=
no_proxy=

# --- AWS (for S3 dataset sync + artifact upload) ---
# Local testing only. On EC2/ECS in production, use an IAM instance/task
# role instead and leave these blank/unset — the aws CLI picks up instance
# credentials automatically, no keys needed in the container.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
